rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function acceptedRequest(requestId, members) {
      let requestPath = /databases/$(database)/documents/friendRequests/$(requestId);
      return exists(requestPath)
        && get(requestPath).data.status == "accepted"
        && get(requestPath).data.senderUid in members
        && get(requestPath).data.recipientUid in members;
    }
    function isFriend(userId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/friendships/$(userId + "_" + request.auth.uid))
        || exists(/databases/$(database)/documents/friendships/$(request.auth.uid + "_" + userId))
      );
    }

    match /profiles/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Friend-code documents contain only a UID and display name, never an email.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "displayName"]);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "displayName"]);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow get, list: if signedIn()
        && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && exists(/databases/$(database)/documents/friendCodes/$(request.resource.data.recipientCode))
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.recipientCode)).data.uid == request.resource.data.recipientUid
        && request.resource.data.status == "pending"
        && requestId == request.auth.uid + "_" + request.resource.data.recipientUid
        && request.resource.data.keys().hasOnly([
          "senderUid", "recipientUid", "recipientCode", "senderName", "recipientName", "status", "createdAt"
        ]);
      allow update: if signedIn() && (
        (resource.data.recipientUid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.status in ["accepted", "declined"]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]))
        ||
        (resource.data.senderUid == request.auth.uid
          && resource.data.status == "declined"
          && request.resource.data.status == "pending"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "createdAt"]))
      );
      allow delete: if signedIn() && resource.data.status == "accepted"
        && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2
        && (friendshipId == request.resource.data.memberUids[0] + "_" + request.resource.data.memberUids[1]
          || friendshipId == request.resource.data.memberUids[1] + "_" + request.resource.data.memberUids[0])
        && acceptedRequest(request.resource.data.requestId, request.resource.data.memberUids)
        && request.resource.data.keys().hasOnly(["memberUids", "displayNames", "requestId", "createdAt"]);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.memberUids;
    }

    match /friendStats/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isFriend(userId));
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "displayName", "date", "dailyUsed", "dailyGoal", "litresSaved", "leaderboardVisible"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.date is string
        && request.resource.data.dailyUsed is number
        && request.resource.data.dailyUsed >= 0
        && request.resource.data.dailyGoal is number
        && request.resource.data.dailyGoal > 0
        && request.resource.data.litresSaved is number
        && request.resource.data.litresSaved >= 0
        && request.resource.data.leaderboardVisible is bool;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}